{
  "name": "wynn-wapi",
  "version": "0.1.0",
  "description": "Wynncraft WAPI helper for Atlas-of-Constellations",
  "type": "module",
  "main": "wapi-client.js",
  "scripts": {
    "start": "node getItems.js",
    "items": "node getItems.js",
    "categorize": "node categorizeItems.js",
    "categories": "node categorizeItems.js --list",
    "stat-list": "node categorizeItems.js --stat-list",
    "stat-walkSpeed": "node categorizeItems.js --stat walkSpeed",
    "pwsh-stat-walkSpeed": "pwsh -NoProfile -Command \"node categorizeItems.js --stat walkSpeed | ConvertFrom-Json\""
  },
  "engines": {
    "node": ">=24"
  }
}
